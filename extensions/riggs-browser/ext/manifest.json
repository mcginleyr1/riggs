{
	"manifest_version": 3,
	"name": "Riggs",
	"version": "0.1.0",
	"description": "Phishing sensor for the Riggs endpoint agent. Reports opened mail and password pages to the local daemon and shows its verdict.",
	"minimum_chrome_version": "106",
	"incognito": "not_allowed",
	"key": "",
	"permissions": ["nativeMessaging", "storage", "webNavigation"],
	"background": { "service_worker": "background.js", "type": "module" },
	"action": { "default_popup": "popup.html" },
	"content_scripts": [
		{
			"matches": ["https://mail.google.com/*"],
			"js": ["banner.js", "gmail.js"]
		},
		{
			"matches": ["http://*/*", "https://*/*"],
			"js": ["banner.js", "page.js"],
			"run_at": "document_start",
			"all_frames": true,
			"match_origin_as_fallback": true
		}
	]
}
